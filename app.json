{
  "expo": {
    "name": "Ally-jis",
    "slug": "allyjis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/group9.png",
    "scheme": "ally",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.allyjis.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "The app needs access to your camera to take photos and scan student IDs.",
        "NSPhotoLibraryUsageDescription": "The app needs access to your photo library to share photos and select profile pictures."
      },
      "associatedDomains": [
        "applinks:ally-jis.com",
        "applinks:www.ally-jis.com"
      ]
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/group9.png",
        "backgroundColor": "#1f663c"
      },
      "package": "com.allyjis.mobile",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ally-jis.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.ally-jis.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/group9.png",
          "color": "#1F663C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photo gallery to select a profile picture.",
          "cameraPermission": "The app needs access to your camera to take a new profile picture."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-image"
    ],
    "updates": {
      "url": "https://u.expo.dev/fb558069-d3da-43c2-ad88-5c3ee45b5144",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb558069-d3da-43c2-ad88-5c3ee45b5144"
      }
    },
    "owner": "ally-jis"
  }
}
