{
  "expo": {
    "name": "Ally-jis",
    "slug": "ally",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/group9.png",
    "scheme": "ally",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.allyjis.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "associatedDomains": [
        "applinks:ally-jis.xyz",
        "applinks:www.ally-jis.xyz"
      ]
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/group9.png",
        "backgroundColor": "#1f663c"
      },
      "package": "xyz.allyjis.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ally-jis.xyz",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.ally-jis.xyz",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/group9.png",
          "color": "#1F663C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photo gallery to select a profile picture.",
          "cameraPermission": "The app needs access to your camera to take a new profile picture."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "updates": {
      "url": "https://u.expo.dev/60c88f1d-8d58-4a90-8a29-c7444e8c1f37",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60c88f1d-8d58-4a90-8a29-c7444e8c1f37"
      }
    }
  }
}
