# Public env vars (prefixed EXPO_PUBLIC_ to be exposed to the client bundle)
#
# Must match the web app's backend — same value as VITE_API_BASE_URL without /api.
# Production: https://api.ally-jis.com
# Local dev:   http://192.168.254.114:5174
EXPO_PUBLIC_API_URL=https://api.ally-jis.com

# ── Google Sign-In (Native) ───────────────────────────────────────────────────
# Web Application Client ID from Google Cloud Console (same one registered in
# Supabase Auth > Google Provider). Required for native Google Sign-In.
# Get it from: console.cloud.google.com → APIs & Services → Credentials
# It looks like: XXXXXXXXXX-xxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=596239075315-01eetnnljsvp3ula13l17pkmfvhber0j.apps.googleusercontent.com
